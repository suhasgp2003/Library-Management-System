# Copy to .env for local development. Never commit real credentials.
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=reading_room
MYSQL_USER=reading_room
MYSQL_PASSWORD=replace-with-your-database-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_TEST_DATABASE=test_reading_room
TIME_ZONE=Asia/Kolkata
LOAN_DAYS=14
MAX_ACTIVE_LOANS=5
RESERVATION_HOLD_DAYS=2
# Production: DEBUG=false, HTTPS host/origin, secure cookies and a new secret.
# CSRF_TRUSTED_ORIGINS=https://your-app.example.com
# DJANGO_TRUST_PROXY=true  # only behind a trusted reverse proxy
# MYSQL_SSL_CA=/path/to/provider-ca.pem
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=library@your-domain.com
